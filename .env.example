# Public Firebase web-app configuration. Never place service-account keys in VITE_*.
# Leave ALL four unset for local, isolated test mode. Partial config blocks the app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY, set in Vercel Preview. Never rename these to VITE_*.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
APP_ORIGIN=
RESEND_API_KEY=
INVITATION_FROM=
# Deliberate opt-in after reviewing domain/provider prerequisites and costs.
INVITATIONS_ENABLED=false
